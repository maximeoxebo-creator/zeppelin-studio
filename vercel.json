{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'Redirection vers zeppelin-studio.zeppelin-apps.com'",
  "outputDirectory": "site",
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://zeppelin-studio.zeppelin-apps.com/$1",
      "permanent": true
    }
  ]
}
